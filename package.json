{
  "name": "signalis",
  "version": "0.2.6",
  "description": "",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "pnpm -r exec rimraf dist",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "pnpm -r test",
    "build": "pnpm build:ts && pnpm build:types",
    "build:ts": "pnpm --filter core --filter react run build",
    "build:types": "pnpm --filter core --filter react run build:types",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "keywords": [],
  "author": "Chris Freeman",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "release-it": "^21.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.14.0",
    "vitest": "^5.0.1"
  },
  "volta": {
    "node": "24.13.1"
  }
